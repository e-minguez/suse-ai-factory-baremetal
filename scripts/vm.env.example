# Variables for the create_*/delete_vm.sh scripts. Copy to scripts/.env (gitignored)
# or pass with -f. Command line flags take precedence. All optional.

# libvirt connection (sushy-tools uses qemu:///system)
#LIBVIRT_DEFAULT_URI="qemu:///system"
# Disk location, must be readable by the qemu user
#VMFOLDER="/var/lib/libvirt/images"
#VM_NETWORK="default"
#CPUS=2
#MEMORY=4096          # MiB
#DISKSIZE=20          # GB (create_vm_with_image.sh: grow the image to this size)
#MACADDRESS=""        # random 52:54:00:xx:xx:xx if empty
#EXTRADISKS=""        # comma separated sizes in GB, e.g. "50,50"
#OSINFO="sle-unknown" # see: virt-install --osinfo list
#LIBVIRT_DISK_SETTINGS="bus=virtio"  # e.g. "bus=virtio,cache=unsafe,discard=unmap"
